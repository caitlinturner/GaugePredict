# Include documentation and license
include README.md
include LICENSE

# Include requirements files
include requirements.txt
include requirements-dev.txt

# Include example data and notebooks
recursive-include Examples *.ipynb *.py *.csv *.json

# Include shapefiles
recursive-include Examples/shapefiles *.shp *.shx *.dbf *.prj *.cpg *.xml

# Exclude Python cache and build artifacts
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
